# Modified from sairam-s0/personal-ai-assistant for the local presales configuration.
# DeepSeek chat API. Prefer DEEPSEEK_*; legacy GROQ_* inputs remain accepted.
# Create your key at https://platform.deepseek.com/api_keys
# Save real values in local .env and restart the server; do not commit .env.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Configurable DeepSeek model; Flash is the default demo and validation model.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_CONTEXT_TOKENS=90000
DEEPSEEK_DEFAULT_MAX_COMPLETION_TOKENS=2048
# Main candidate generation and its independent review share this setting.
DEEPSEEK_TOOL_OUTPUT_MODE=deepseek_strict_beta

# Pinned local CPU embedding model. Paths are relative to the project root.
EMBEDDING_CACHE_DIR=data/embedding_models
EMBEDDING_THREADS=2

# Created/initialized automatically when the application starts.
SAAS_DATABASE_URL=sqlite:///data/saas_assistant.db
APP_ENV=development
